# Sanity CMS Configuration
# Copy this file to .env and fill in your actual values

VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
VITE_SANITY_USE_CDN=true
VITE_SANITY_TOKEN=your-token-optional

# GitHub API Configuration (Optional - for better rate limiting)
VITE_GITHUB_TOKEN=your-github-token-optional

# Note: Replace 'your-project-id' with your actual Sanity project ID
# The Sanity token is optional and only needed for authenticated requests
# The GitHub token is optional but recommended to avoid rate limiting 